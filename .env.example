# Copy to .env (ignored by git) or export in your shell. Nothing here is a secret by itself:
# the private key stays in a file outside the repository and only its path is configured.

# Private key of the service user (PKCS#8 PEM). Used by every command except the bootstrap.
SNOWFLAKE_PRIVATE_KEY_FILE=/absolute/path/outside/the/repo/svc_dev_rsa_key.p8
# Only if the key is encrypted:
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Only for `factory platform bootstrap`, with the key of an account administrator:
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=ACCOUNTADMIN

# AWS credentials come from the standard chain; the profile is only needed for Terraform and
# for uploading sample files.
# AWS_PROFILE=
