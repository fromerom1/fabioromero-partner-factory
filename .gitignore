# Secrets and local credentials: never commit
.env
.env.*
!.env.example
*.p8
*.pem
*.key
profiles.yml
# The project profile holds no credentials, only references to environment variables
!dbt/profiles.yml
.snowflake/
.aws/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# dbt
target/
dbt_packages/
logs/
.user.yml

# Terraform: state and generated variable files hold account identifiers
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
*.auto.tfvars.json
crash.log

# Airflow / Astro (airflow/.gitignore covers the rest of the Astro project)
airflow.db
airflow-webserver.pid

# OS / editor
.DS_Store
.idea/
.vscode/
