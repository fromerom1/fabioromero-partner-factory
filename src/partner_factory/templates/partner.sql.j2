-- Loader objects of partner {{ partner.partner_code }} in {{ platform.environment }}.
-- Generated from partners/{{ partner.prefix }}.yml. Run by the service user, which owns them.
-- Every statement is idempotent: deploying twice changes nothing.

CREATE DATABASE IF NOT EXISTS {{ database }}
    COMMENT = {{ (partner.display_name ~ ': partner factory, ' ~ platform.environment) | literal }};

CREATE SCHEMA IF NOT EXISTS {{ database }}.RAW
    COMMENT = 'Records exactly as delivered by the partner. Append-only, loaded by Snowpipe';

CREATE SCHEMA IF NOT EXISTS {{ database }}.PROCESSED
    COMMENT = 'Standard model: validated, deduplicated and normalized';

CREATE SCHEMA IF NOT EXISTS {{ database }}.ANALYTICS
    COMMENT = 'Reporting layer';

CREATE STAGE IF NOT EXISTS {{ database }}.RAW.LANDING
    URL = {{ landing_url | literal }}
    STORAGE_INTEGRATION = {{ sf.storage_integration }}
    COMMENT = 'Where the partner delivers files';

CREATE STAGE IF NOT EXISTS {{ database }}.RAW.HISTORICAL
    URL = {{ historical_url | literal }}
    STORAGE_INTEGRATION = {{ sf.storage_integration }}
    COMMENT = 'Where files are kept once they have been loaded and processed';

-- Secret used to pseudonymize customer identifiers, one per partner so that references cannot
-- be linked across partners. It lives in RAW, the one schema that is never granted to readers,
-- and is generated inside Snowflake: it never exists in a file, a log or this repository.
CREATE TABLE IF NOT EXISTS {{ database }}.RAW.{{ key_table }} (
    KEY_VALUE   VARCHAR        NOT NULL,
    CREATED_AT  TIMESTAMP_LTZ  NOT NULL
)
    COMMENT = 'Pseudonymization key of the partner. Deleting it makes every customer_ref unlinkable';

INSERT INTO {{ database }}.RAW.{{ key_table }} (KEY_VALUE, CREATED_AT)
SELECT SHA2(CONCAT(UUID_STRING(), UUID_STRING()), 256), CURRENT_TIMESTAMP()
WHERE NOT EXISTS (SELECT 1 FROM {{ database }}.RAW.{{ key_table }});

-- Personal data is marked where it lives: the raw records of the sources that carry it, the
-- key that pseudonymizes it and the customer reference of the standard model. The last one is
-- tagged by dbt, in the run that builds the table.
CREATE TAG IF NOT EXISTS {{ pii_tag }}
    ALLOWED_VALUES {{ pii_values.customer_data | literal }}, {{ pii_values.pseudonym | literal }}, {{ pii_values.key | literal }}
    COMMENT = 'Personal data, by kind: as delivered, pseudonymized, or the key that links the two';

ALTER TABLE {{ database }}.RAW.{{ key_table }} SET TAG {{ pii_tag }} = {{ pii_values.key | literal }};

-- Who sees a customer reference: the pipeline, which computes and compares it, and fraud/credit.
-- Every other role gets NULL. dbt attaches the policy to the column in the run that builds
-- the table, so a rebuilt table is never readable without it.
CREATE MASKING POLICY IF NOT EXISTS {{ customer_ref_policy }}
    AS (value VARCHAR) RETURNS VARCHAR ->
    CASE
        WHEN IS_ROLE_IN_SESSION({{ sf.pipeline_role | literal }})
            OR IS_ROLE_IN_SESSION({{ sf.fraud_credit_role | literal }}) THEN value
    END
    COMMENT = 'Customer references are visible to the pipeline and to fraud/credit only';

-- Readers enter the database and the two schemas they read from. RAW is never granted, and
-- inside PROCESSED they get the standard tables only: dbt grants those, table by table.
{% for role in sf.reader_roles %}
GRANT USAGE ON DATABASE {{ database }} TO ROLE {{ role }};
GRANT USAGE ON SCHEMA {{ database }}.PROCESSED TO ROLE {{ role }};
GRANT USAGE ON SCHEMA {{ database }}.ANALYTICS TO ROLE {{ role }};
{% endfor %}
{% for source in sources %}

-- Source "{{ source.name }}"
CREATE FILE FORMAT IF NOT EXISTS {{ database }}.RAW.{{ source.file_format }}
    {{ source.file_format_options | join('\n    ') }};

-- Same shape for every source and format: the record as a VARIANT plus where it came from.
-- Nothing is typed or rejected here, so a bad row never blocks a load.
CREATE TABLE IF NOT EXISTS {{ database }}.RAW.{{ source.table }} (
    RECORD              VARIANT        COMMENT 'One delivered record, untyped',
    SOURCE_FILE         VARCHAR        COMMENT 'Path of the file in the bucket',
    FILE_ROW_NUMBER     NUMBER(38, 0)  COMMENT 'Position of the record in the file, starting at 1',
    FILE_LAST_MODIFIED  TIMESTAMP_NTZ  COMMENT 'When the partner delivered the file (UTC)',
    FILE_CONTENT_KEY    VARCHAR        COMMENT 'Checksum of the file content, to tell re-sent files apart',
    LOADED_AT           TIMESTAMP_LTZ  COMMENT 'When the platform loaded the record'
)
    COMMENT = {{ (partner.partner_code ~ ' / ' ~ source.name ~ ': ' ~ source.description) | literal }};
{% if source.personal_data %}

ALTER TABLE {{ database }}.RAW.{{ source.table }} MODIFY COLUMN RECORD
    SET TAG {{ pii_tag }} = {{ pii_values.customer_data | literal }};
{% endif %}

-- LOADED_AT uses METADATA$START_SCAN_TIME: inside a pipe CURRENT_TIMESTAMP is evaluated when
-- the load is compiled, not when the file is loaded.
CREATE PIPE IF NOT EXISTS {{ database }}.RAW.{{ source.pipe }}
    AUTO_INGEST = TRUE
    COMMENT = {{ ('Loads ' ~ source.name ~ ' files of ' ~ partner.partner_code ~ ' as they arrive') | literal }}
AS
COPY INTO {{ database }}.RAW.{{ source.table }}
    (RECORD, SOURCE_FILE, FILE_ROW_NUMBER, FILE_LAST_MODIFIED, FILE_CONTENT_KEY, LOADED_AT)
FROM (
    SELECT
        {{ source.record_expression }},
        METADATA$FILENAME,
        METADATA$FILE_ROW_NUMBER,
        METADATA$FILE_LAST_MODIFIED,
        METADATA$FILE_CONTENT_KEY,
        METADATA$START_SCAN_TIME
    FROM @{{ database }}.RAW.LANDING
)
PATTERN = {{ source.file_pattern | literal }}
FILE_FORMAT = (FORMAT_NAME = {{ (database ~ '.RAW.' ~ source.file_format) | literal }})
ON_ERROR = CONTINUE;
{% endfor %}
